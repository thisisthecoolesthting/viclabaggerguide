---
import CompliantLayout from '@/layouts/CompliantLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import home from '@/data/spawn-home.json';

const about = (home as { about?: { headline?: string; body?: string } }).about;
const headline = about?.headline ?? 'Why Vicla Bagger Guide exists';
const body =
  about?.body ??
  'We organize Amazon-buyable tools, detail gear, security, and ride kits for Vicla and lowrider-inspired bagger builds.';
---

<CompliantLayout
  title="About"
  description="What Vicla Bagger Guide is, why it exists, and how we choose gear for Vicla and cholo-style bagger builds."
  sectionAds="about"
>
  <PageIntro
    eyebrow="About Vicla Bagger Guide"
    title={headline}
    description="Independent gear guides for Vicla, Chicano-style, and lowrider-inspired bagger builds — not affiliated with Harley-Davidson or any motorcycle manufacturer."
  />

  <section class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 pb-10 md:pb-14">
    <article class="content-panel max-w-3xl mx-auto prose prose-lg prose-ink">
      <p class="!mt-0">{body}</p>

      <h2>How we pick gear</h2>
      <p>
        We prioritize chrome care, whitewall maintenance, fitment notes for touring baggers,
        verified Amazon listings with strong review signals, and gear we would pack on our own
        bikes. We decline paid placements and do not let commissions change sort order.
      </p>

      <h2>How we make money</h2>
      <p>
        <strong>As an Amazon Associate I earn from qualifying purchases.</strong>
        Revenue is Amazon Associates only. See our full
        <a href="/disclosure">partner disclosure</a>.
      </p>

      <h2>Trademark notice</h2>
      <p>
        Vicla Bagger Guide is not affiliated with, endorsed by, or sponsored by
        Harley-Davidson, Inc. or any motorcycle manufacturer. Product names and
        trademarks belong to their owners. Always confirm fitment with the seller
        before you buy.
      </p>

      <h2>Get in touch</h2>
      <p>
        Questions, corrections, or fitment notes:
        <a href="mailto:hello@viclabaggerguide.org">hello@viclabaggerguide.org</a>.
      </p>
    </article>
  </section>

  <section class="section-band-sage">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
      <div class="content-panel-muted max-w-3xl mx-auto">
        <NewsletterForm variant="hero" />
      </div>
    </div>
  </section>
</CompliantLayout>
