---
import CompliantLayout from '@/layouts/CompliantLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import home from '@/data/spawn-home.json';

const b = home.brand;
const editorial = (home as { editorial?: { methodology?: string[]; author_slug?: string } }).editorial;
const defaultAuthorSlug = (home as { defaultAuthorSlug?: string }).defaultAuthorSlug || 'miguel-vega-viclabaggerguide';
const leadAuthorSlug = editorial?.author_slug || defaultAuthorSlug;
const methodology = (editorial?.methodology || []).filter(Boolean);
const supportEmail = (home as { supportEmail?: string }).supportEmail || 'hello@viclabaggerguide.org';
---

<CompliantLayout
  title="How Vicla Bagger Guide researches and recommends"
  description="How Vicla Bagger Guide evaluates bagger gear, handles Amazon links, and keeps editorial decisions independent."
  sectionAds="legal"
>
  <PageIntro
    eyebrow="Methodology"
    title="How we research, test, and recommend"
    description="Practical buyer guides for Vicla and cholo-style bagger builds — fitment notes, honest comparisons, and no pay-to-play rankings."
  />

  <section class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 pb-14 md:pb-20">
    <article class="content-panel max-w-prose mx-auto prose prose-lg prose-ink">
      <p class="!mt-0">
        <strong>As an Amazon Associate I earn from qualifying purchases.</strong>
      </p>
      <p>
        We are not affiliated with, endorsed by, or sponsored by Harley-Davidson, Inc. or any
        motorcycle manufacturer.
      </p>

      <h2>Our mission</h2>
      <p>
        {b.fullName} exists because bagger riders who treat chrome, whitewalls, and custom
        trim like rolling art deserve organized gear lists — not scattered forum threads and
        dealer upsells. We document what helps you clean, protect, wrench, and cruise.
      </p>

      <h2>How we evaluate gear</h2>
      {methodology.length > 0 ? (
        <ul>
          {methodology.map((item) => <li>{item}</li>)}
        </ul>
      ) : (
        <ul>
          <li>We prioritize Amazon listings with real buyer photos and clear fitment language.</li>
          <li>We do not publish live prices unless pulled from approved catalog data at build time.</li>
          <li>Every buying guide includes: As an Amazon Associate I earn from qualifying purchases.</li>
          <li>We are not affiliated with Harley-Davidson, Inc. or any motorcycle OEM.</li>
        </ul>
      )}

      <h2>Editorial lead</h2>
      <p>
        Primary reviewer: <a href={`/authors/${leadAuthorSlug}/`}>{leadAuthorSlug.replace(/-/g, ' ')}</a>.
      </p>

      <h2>Corrections</h2>
      <p>
        Fitment errors or discontinued ASINs:
        <a href={`mailto:${supportEmail}`}>{supportEmail}</a>. We correct fast when readers flag bad links.
      </p>
    </article>
  </section>
</CompliantLayout>
